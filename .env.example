# Public site URL (used in OAuth redirects, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter (LLM analysis + practice grading)
# Get a key at https://openrouter.ai/keys — uses free models by default.
OPENROUTER_API_KEY=sk-or-v1-...

# Deepgram (transcription)
DEEPGRAM_API_KEY=your-deepgram-key

# Stripe (global billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PRO_ANNUAL_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_SPRINT_PRICE_ID=price_...

# Razorpay (Indian billing)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_PRO_MONTHLY_PLAN_ID=plan_...
RAZORPAY_SPRINT_AMOUNT_INR=99900

# Resend (transactional email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Stagehand <hello@stagehand.app>

# Cron / job auth
JOBS_SECRET=generate-a-random-secret
